<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Android 系统创建进程时先显示这一轻量原生主题，随后由 NativeSplashView 绘制用户方案。 -->
    <style name="NativeLaunchThemeBase" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/native_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/native_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">120</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/native_splash_background</item>
        <item name="android:statusBarColor">@color/native_splash_background</item>
        <item name="android:navigationBarColor">@color/native_splash_background</item>
    </style>

    <style name="NativeLaunchTheme" parent="NativeLaunchThemeBase">
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
